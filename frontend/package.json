{
  "name": "plagacontrol-app",
  "version": "1.0.0",
  "description": "PlagaControl - Sistema móvil de control y reporte de plagas agrícolas",
  "author": "PlagaControl",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node ./node_modules/@angular/cli/bin/ng.js build --configuration=production",
    "postinstall": "node ./node_modules/patch-package/index.js || true",
    "watch": "ng build --watch --configuration=development",
    "test": "ng test",
    "ionic:build": "ng build --configuration=production",
    "ionic:serve": "ng serve"
  },
  "dependencies": {
    "@angular/animations": "~17.3.0",
    "@angular/common": "~17.3.0",
    "@angular/compiler": "~17.3.0",
    "@angular/core": "~17.3.0",
    "@angular/forms": "~17.3.0",
    "@angular/platform-browser": "~17.3.0",
    "@angular/platform-browser-dynamic": "~17.3.0",
    "@angular/router": "~17.3.0",
    "@capacitor/android": "^5.6.0",
    "@capacitor/camera": "^5.0.8",
    "@capacitor/core": "^5.6.0",
    "@capacitor/filesystem": "^5.2.0",
    "@capacitor/geolocation": "^5.0.8",
    "@ionic/angular": "^7.8.0",
    "bootstrap": "^5.3.3",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~17.3.0",
    "@angular/cli": "~17.3.0",
    "@angular/compiler-cli": "~17.3.0",
    "@capacitor/cli": "^5.7.8",
    "@ionic/angular-toolkit": "^10.0.0",
    "@types/leaflet": "^1.9.8",
    "patch-package": "^8.0.0",
    "typescript": "~5.4.0"
